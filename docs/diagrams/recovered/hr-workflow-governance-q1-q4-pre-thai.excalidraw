      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Main principle: Frontend can hide for UX, but Backend must decide and enforce. Workflow should orchestrate approvals, not become the employee-data authority.",
      "fontSize": 26,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Main principle: Frontend can hide for UX, but Backend must decide and enforce. Workflow should orchestrate approvals, not become the employee-data authority.",
      "lineHeight": 1.25
    },
